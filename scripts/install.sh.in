#!/bin/sh
# Generated by render-installer.py. All embedded files come from the release.
set -eu
PATH="/usr/sbin:/usr/bin:/sbin:/bin:/system/sbin:/system/bin${PATH:+:$PATH}"
export PATH
VERSION='@@VERSION@@'
EXPECTED_SHA='@@SHA256@@'
DOWNLOAD_URL=${DATAD_DOWNLOAD_URL:-'@@DOWNLOAD_URL@@'}
DIR=/data/zwrt-datad
BIN=$DIR/zwrt-datad
RC=/etc/rc.local
WORK=
BACKUP=
SMOKE_PID=
CHANGED=0
STOPPED=0
SUCCESS=0
WAS_RUNNING=0
WAS_CLOUD_RUNNING=0
RC_WRITTEN=0

say() { printf '[datad-install] %s\n' "$*"; }
fail() { say "$*" >&2; exit 1; }
health() { curl -fsS --connect-timeout 2 --max-time 3 "http://127.0.0.1:$1/healthz" >/dev/null; }
wait_health() {
    count=0
    while [ "$count" -lt 20 ]; do
        health "$1" && return 0
        sleep 1; count=$((count+1))
    done
    return 1
}
known_binary() {
    case "$1" in
        /data/zwrt-datad/zwrt-datad|/data/plugins/zwrt-datad/zwrt-datad|/data/data/zwrt-datad/zwrt-datad|/data/plugins/u60-datad/u60-datad|/data/u60-datad/u60-datad) return 0 ;;
        *) return 1 ;;
    esac
}
running_pids() {
    for proc in /proc/[0-9]*; do
        actual=$(readlink "$proc/exe" 2>/dev/null || true)
        actual=${actual% (deleted)}
        if known_binary "$actual"; then printf '%s\n' "${proc##*/}"; fi
    done
}
stop_known() {
    for pid in $(running_pids); do
        kill -TERM "$pid" 2>/dev/null || true
    done
    count=0
    while [ -n "$(running_pids)" ] && [ "$count" -lt 10 ]; do sleep 1; count=$((count+1)); done
    for pid in $(running_pids); do kill -KILL "$pid" 2>/dev/null || true; done
}
legacy_cloud_pids() {
    for proc in /proc/[0-9]*; do
        actual=$(readlink "$proc/exe" 2>/dev/null || true)
        actual=${actual% (deleted)}
        case "$actual" in
            /data/zwrt-datad/zwrt-datad-cloud|/data/plugins/zwrt-datad/zwrt-datad-cloud|/data/data/zwrt-datad/zwrt-datad-cloud)
                printf '%s\n' "${proc##*/}" ;;
        esac
    done
}
stop_legacy_cloud() {
    for pid in $(legacy_cloud_pids); do kill -TERM "$pid" 2>/dev/null || true; done
    count=0
    while [ -n "$(legacy_cloud_pids)" ] && [ "$count" -lt 10 ]; do sleep 1; count=$((count+1)); done
    for pid in $(legacy_cloud_pids); do kill -KILL "$pid" 2>/dev/null || true; done
    rm -f "$DIR/cloud.pid" "$DIR/cloud.sock" "$DIR/cloud.lock"
}
save_file() {
    if [ -e "$1" ]; then cp -p "$1" "$BACKUP/$2"; else : > "$BACKUP/$2.absent"; fi
}
restore_file() {
    if [ -e "$BACKUP/$2" ]; then
        cp -p "$BACKUP/$2" "$1.restore.$$" && mv -f "$1.restore.$$" "$1"
    elif [ -e "$BACKUP/$2.absent" ]; then rm -f "$1"; fi
}
stop_smoke() {
    if [ -n "$SMOKE_PID" ]; then
        kill -TERM "$SMOKE_PID" 2>/dev/null || true
        count=0
        while kill -0 "$SMOKE_PID" 2>/dev/null && [ "$count" -lt 10 ]; do sleep 1; count=$((count+1)); done
        kill -KILL "$SMOKE_PID" 2>/dev/null || true
        wait "$SMOKE_PID" 2>/dev/null || true
        SMOKE_PID=
    fi
}
cleanup() {
    status=$?
    trap - EXIT HUP INT TERM
    set +e
    stop_smoke
    if [ "$SUCCESS" != 1 ] && [ "$CHANGED" = 1 ]; then
        say "安装失败，恢复原文件和服务"
        stop_known
        for name in zwrt-datad service.sh version.json OPENSSL-LICENSE.txt zwrt-datad-cloud cloud-service.sh; do restore_file "$DIR/$name" "$name"; done
        [ "$RC_WRITTEN" = 0 ] || restore_file "$RC" rc.local
        for link in "$BACKUP/legacy-links"/*; do
            [ -L "$link" ] || continue
            cp -P "$link" "/etc/rc.d/${link##*/}"
        done
        if [ "$WAS_RUNNING" = 1 ] && [ -f "$BACKUP/original-service" ]; then
            IFS= read -r original_service < "$BACKUP/original-service"
            sh "$original_service" start 9>&- || true
        elif [ "$WAS_CLOUD_RUNNING" = 1 ] && [ -f "$DIR/cloud-service.sh" ]; then
            sh "$DIR/cloud-service.sh" start 9>&- || true
        fi
    elif [ "$SUCCESS" != 1 ] && [ "$STOPPED" = 1 ] && [ "$WAS_RUNNING" = 1 ]; then
        sh "$DIR/service.sh" start 9>&- || true
    fi
    [ -z "$WORK" ] || rm -rf "$WORK"
    exit "$status"
}

[ "$(id -u)" = 0 ] || fail "请使用 root 执行"
case "$(uname -m)" in aarch64|arm64) ;; *) fail "仅支持 ARM64/aarch64" ;; esac
for cmd in curl sha256sum awk cmp stat flock mktemp readlink od; do
    command -v "$cmd" >/dev/null 2>&1 || fail "缺少命令：$cmd"
done
case "$DOWNLOAD_URL" in https://*) ;; *) fail "下载地址必须为 HTTPS" ;; esac
mkdir -p "$DIR"
exec 9> "$DIR/.install.lock"
flock -n 9 || fail "另一个安装进程正在运行"
umask 077
WORK=$(mktemp -d /tmp/datad-install.XXXXXX)
trap cleanup EXIT
trap 'exit 130' HUP INT TERM

cat > "$WORK/service.sh" <<'DATAD_SERVICE_EOF'
@@SERVICE@@
DATAD_SERVICE_EOF
cat > "$WORK/version.json" <<'DATAD_MANIFEST_EOF'
@@MANIFEST@@
DATAD_MANIFEST_EOF
cat > "$WORK/rc.awk" <<'DATAD_RC_AWK_EOF'
@@RC_AWK@@
DATAD_RC_AWK_EOF

# Validate boot changes before touching the running service.
if [ -e "$RC" ]; then
    [ -f "$RC" ] && [ ! -L "$RC" ] || fail "rc.local 必须是普通文件"
    cp -p "$RC" "$WORK/rc.before"
else
    printf '#!/bin/sh\n\nexit 0\n' > "$WORK/rc.before"
fi
awk -f "$WORK/rc.awk" "$WORK/rc.before" > "$WORK/rc.after" || fail "无法安全整理 rc.local"
sh -n "$WORK/rc.after" || fail "整理后的 rc.local 语法错误"
RC_CHANGED=1
if [ -f "$RC" ] && cmp -s "$RC" "$WORK/rc.after"; then RC_CHANGED=0; fi

# An enabled legacy init script would start a duplicate before rc.local.
# Keep the script itself; remove only its boot symlinks after success.
: > "$WORK/legacy-links"
for link in /etc/rc.d/*; do
    [ -L "$link" ] || continue
    target=$(readlink -f "$link" 2>/dev/null || true)
    case "$target" in
        /etc/init.d/zwrt-datad|/etc/init.d/u60-datad) printf '%s\n' "$link" >> "$WORK/legacy-links" ;;
    esac
done

if [ -f "$BIN" ] && [ "$(sha256sum "$BIN" | awk '{print $1}')" = "$EXPECTED_SHA" ]; then
    cp "$BIN" "$WORK/zwrt-datad"
    say "现有二进制校验一致，跳过重复下载"
else
    say "下载 datad v$VERSION"
    attempt=1
    while ! curl -4fLsS --connect-timeout 15 --max-time 180 "$DOWNLOAD_URL" -o "$WORK/zwrt-datad"; do
        rm -f "$WORK/zwrt-datad"
        [ "$attempt" -lt 3 ] || fail "下载失败，原安装保持不变"
        attempt=$((attempt+1)); say "下载中断，重试 $attempt/3"; sleep 2
    done
fi
printf '%s  %s\n' "$EXPECTED_SHA" "$WORK/zwrt-datad" | sha256sum -c - >/dev/null || fail "二进制 SHA-256 不匹配"
[ "$(od -An -tx1 -N6 "$WORK/zwrt-datad" | tr -d ' \n')" = 7f454c460201 ] || fail "不是 ELF64 little-endian 二进制"
[ "$(od -An -tx1 -j18 -N2 "$WORK/zwrt-datad" | tr -d ' \n')" = b700 ] || fail "二进制不是 AArch64"
chmod 755 "$WORK/zwrt-datad"
"$WORK/zwrt-datad" --help >/dev/null || fail "临时二进制启动检查失败"

FILES_CHANGED=0
BINARY_CHANGED=0
SERVICE_CHANGED=0
for name in zwrt-datad service.sh version.json; do
    if ! cmp -s "$WORK/$name" "$DIR/$name"; then
        FILES_CHANGED=1
        [ "$name" != zwrt-datad ] || BINARY_CHANGED=1
        [ "$name" != service.sh ] || SERVICE_CHANGED=1
    fi
done
[ -x "$BIN" ] || BINARY_CHANGED=1
PIDS=$(running_pids)
[ -z "$PIDS" ] || WAS_RUNNING=1
CLOUD_PIDS=$(legacy_cloud_pids)
[ -z "$CLOUD_PIDS" ] || WAS_CLOUD_RUNNING=1
LEGACY_RESIDUE=0
[ -z "$CLOUD_PIDS" ] || LEGACY_RESIDUE=1
for legacy_cloud_file in zwrt-datad-cloud cloud-service.sh cloud.pid cloud.sock cloud.lock; do
    [ ! -e "$DIR/$legacy_cloud_file" ] || LEGACY_RESIDUE=1
done
[ ! -e "$DIR/OPENSSL-LICENSE.txt" ] || LEGACY_RESIDUE=1
NEED_START=1
if [ "$BINARY_CHANGED" = 0 ] && [ "$SERVICE_CHANGED" = 0 ] && [ "$(printf '%s\n' "$PIDS" | awk 'NF{n++} END{print n+0}')" = 1 ] && health 9460 && health 9461; then
    actual=$(readlink "/proc/$PIDS/exe" 2>/dev/null || true)
    [ "$actual" != "$BIN" ] || NEED_START=0
fi
if [ "$FILES_CHANGED" = 0 ] && [ "$RC_CHANGED" = 0 ] && [ ! -s "$WORK/legacy-links" ] && [ "$NEED_START" = 0 ] && [ "$LEGACY_RESIDUE" = 0 ]; then
    SUCCESS=1
    say "v$VERSION 已安装；安装文件和自启一致，无需重写或重启服务"
    exit 0
fi

BACKUP="$DIR/backups/install-$(date +%Y%m%d-%H%M%S)-$$"
mkdir -p "$BACKUP"
chmod 700 "$BACKUP"
for name in zwrt-datad service.sh version.json OPENSSL-LICENSE.txt zwrt-datad-cloud cloud-service.sh; do save_file "$DIR/$name" "$name"; done
save_file "$RC" rc.local
printf '%s\n' "$DIR/service.sh" > "$BACKUP/original-service"
CHANGED=1
for pid in $PIDS; do
    old=$(readlink "/proc/$pid/exe" 2>/dev/null || true); old=${old% (deleted)}
    old_dir=${old%/*}
    if [ "$old_dir" != "$DIR" ] && [ -f "$old_dir/service.sh" ]; then
        printf '%s\n' "$old_dir/service.sh" > "$BACKUP/original-service"
        # Preserve existing device configuration when migrating a known path.
        for config in auth.token cloud.json cooling.conf; do
            if [ ! -e "$DIR/$config" ] && [ -f "$old_dir/$config" ]; then cp -p "$old_dir/$config" "$DIR/$config"; fi
        done
    fi
done
if [ "$LEGACY_RESIDUE" = 1 ]; then stop_legacy_cloud; fi
if [ "$NEED_START" = 1 ]; then
    IFS= read -r original_service < "$BACKUP/original-service"
    if [ -f "$original_service" ]; then sh "$original_service" stop 9>&-; fi
    for legacy_init in /etc/init.d/zwrt-datad /etc/init.d/u60-datad; do
        [ ! -f "$legacy_init" ] || sh "$legacy_init" stop 9>&-
    done
    stop_known
    STOPPED=1
    # Only one datad controller runs at a time, including this loopback smoke.
    (cd "$DIR" && ZWRT_DATAD_DIR="$WORK/cloud" exec "$WORK/zwrt-datad" -b 127.0.0.1 -p 19460 -i 1000) > "$WORK/smoke.log" 2>&1 9>&- &
    SMOKE_PID=$!
    wait_health 19460 || fail "临时服务健康检查失败"
    [ "$(readlink "/proc/$SMOKE_PID/exe" 2>/dev/null || true)" = "$WORK/zwrt-datad" ] || fail "临时端口未由候选进程提供"
    curl -fsS --max-time 10 http://127.0.0.1:19460/state -o /dev/null || fail "临时状态接口检查失败"
    stop_smoke
fi

for name in zwrt-datad service.sh version.json; do
    if ! cmp -s "$WORK/$name" "$DIR/$name"; then
        cp "$WORK/$name" "$DIR/$name.new.$$"
        case "$name" in zwrt-datad|service.sh) chmod 755 "$DIR/$name.new.$$" ;; *) chmod 644 "$DIR/$name.new.$$" ;; esac
        mv -f "$DIR/$name.new.$$" "$DIR/$name"
    fi
done
if [ "$NEED_START" = 1 ]; then sh "$DIR/service.sh" start 9>&-; fi
wait_health 9460 && wait_health 9461 || fail "正式服务健康检查失败"
curl -fsS --max-time 10 http://127.0.0.1:9460/state -o /dev/null || fail "正式状态接口检查失败"
[ "$(running_pids | awk 'NF{n++} END{print n+0}')" = 1 ] || fail "检测到重复 datad 进程"

if [ "$RC_CHANGED" = 1 ]; then
    # Detect an operator changing rc.local while download/smoke was running.
    if [ -e "$RC" ]; then cmp -s "$RC" "$WORK/rc.before" || fail "安装期间 rc.local 被其他程序修改"; fi
    cp "$WORK/rc.after" "$RC.new.$$"
    if [ -e "$RC" ]; then
        chmod "$(stat -c %a "$RC")" "$RC.new.$$"
        chown "$(stat -c %u "$RC"):$(stat -c %g "$RC")" "$RC.new.$$"
    else chmod 755 "$RC.new.$$"; fi
    chmod u+x "$RC.new.$$"
    mv -f "$RC.new.$$" "$RC"
    RC_WRITTEN=1
    say "已清理旧自启项，写入唯一标准启动命令"
else say "自启项一致，rc.local 未重写"; fi
mkdir -p "$BACKUP/legacy-links"
while IFS= read -r link; do
    [ -n "$link" ] || continue
    cp -P "$link" "$BACKUP/legacy-links/${link##*/}"
    rm "$link"
done < "$WORK/legacy-links"
rm -f "$DIR/zwrt-datad-cloud" "$DIR/cloud-service.sh" "$DIR/cloud.pid" "$DIR/cloud.sock" "$DIR/cloud.lock" "$DIR/OPENSSL-LICENSE.txt"
SUCCESS=1
say "安装完成：v$VERSION，$BIN"
say "自启：sh /data/zwrt-datad/service.sh start"
say "备份：$BACKUP"
