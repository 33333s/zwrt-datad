#!/bin/sh
# Pinned zwrt-datad installer for the ARMv7 ZTE U50S (version and SHA-256 below).
#
# It installs only the binary whose SHA-256 is pinned below. The running daemon
# downloads and verifies the binary itself (this firmware has no curl/wget) and
# stages it as DATAD_BINARY_FILE on the same volume as the installed binary, so
# the final step is an atomic rename. If the new version does not come up
# healthy, the previous binary is restored.
set -eu

VERSION='@@VERSION@@'
SHA256='@@SHA256@@'
DIR="${DATAD_DIR:-/etc_rw/zwrt-datad}"
BIN="$DIR/zwrt-datad"
NEW="${DATAD_BINARY_FILE:-$DIR/zwrt-datad.new}"
PREV="$DIR/zwrt-datad.prev"
UNIT=zwrt-datad.service
PROC="${DATAD_PROC:-/proc}"
WAIT_SECONDS="${DATAD_HEALTH_WAIT:-60}"
STABLE_SECONDS="${DATAD_HEALTH_STABLE:-10}"

die() { echo "install-datad: $*" >&2; exit 1; }

[ -f "$NEW" ] || die "staged binary $NEW is missing"
case "$NEW" in "$DIR"/*) ;; *) die "staged binary must be inside $DIR" ;; esac
[ "$(sha256sum "$NEW" | cut -d' ' -f1)" = "$SHA256" ] || die "SHA-256 mismatch"
chmod 700 "$NEW"
[ "$("$NEW" --version)" = "zwrt-datad $VERSION" ] || die "unexpected version"
[ -f "$BIN" ] || die "no installed binary to replace"

restart_service() {
    if command -v systemctl >/dev/null 2>&1 && systemctl cat "$UNIT" >/dev/null 2>&1; then
        systemctl restart "$UNIT"
    else
        sh "$DIR/service.sh" stop >/dev/null 2>&1 || true
        sh "$DIR/service.sh" start
    fi
}

running_pid() {
    if command -v systemctl >/dev/null 2>&1 && systemctl cat "$UNIT" >/dev/null 2>&1; then
        systemctl is-active --quiet "$UNIT" || return 1
        systemctl show -p MainPID --value "$UNIT"
    else
        [ -r "$DIR/zwrt-datad.pid" ] && cat "$DIR/zwrt-datad.pid"
    fi
}

# The service must run the new file and keep running for a few seconds.
healthy() {
    want="$1"
    waited=0
    while [ "$waited" -lt "$WAIT_SECONDS" ]; do
        pid=$(running_pid 2>/dev/null || true)
        if [ -n "$pid" ] && [ "$pid" != 0 ] && [ -r "$PROC/$pid/exe" ] \
            && [ "$(sha256sum "$PROC/$pid/exe" | cut -d' ' -f1)" = "$want" ]; then
            sleep "$STABLE_SECONDS"
            [ "$(running_pid 2>/dev/null || true)" = "$pid" ] && return 0
        fi
        sleep 2
        waited=$((waited + 2 + STABLE_SECONDS))
    done
    return 1
}

previous_sha=$(sha256sum "$BIN" | cut -d' ' -f1)
rm -f "$PREV"
mv "$BIN" "$PREV"
mv "$NEW" "$BIN"
restart_service || true
if healthy "$SHA256"; then
    rm -f "$PREV"
    echo "installed zwrt-datad $VERSION"
    exit 0
fi

echo "install-datad: $VERSION did not become healthy, restoring the previous binary" >&2
mv -f "$PREV" "$BIN"
restart_service || true
healthy "$previous_sha" || echo "install-datad: previous binary did not confirm healthy either" >&2
exit 1
